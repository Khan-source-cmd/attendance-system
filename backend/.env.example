# Copy this file to backend/.env and fill in real values. backend/.env is gitignored.
# NEVER commit real secrets. Rotate any value that has ever been pushed to a repo.

# Server
PORT=4000

# Authentication - generate strong random values, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
JWT_RESET_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET

# Email (used for OTP verification + password reset)
EMAIL_USER=your_account@gmail.com
EMAIL_PASS=your_gmail_app_password

# Frontend URL used in reset links
FRONTEND_URL=http://localhost:4000

# Comma-separated allow-list of CORS origins (no wildcard)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4000